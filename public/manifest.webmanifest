    { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tareas", "url": "/#/tareas", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Contactos", "url": "/#/contactos", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Negocios", "url": "/#/negocios", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
