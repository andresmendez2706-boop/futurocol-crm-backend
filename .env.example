# Copia este archivo como .env y ajusta los valores.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://crm:crm@localhost:5432/futurocol_crm
# Secreto para firmar las sesiones: usa una cadena larga y aleatoria (p. ej. `openssl rand -hex 32`).
JWT_SECRET=
SESSION_HOURS=12
APP_TIMEZONE=America/Bogota
AUTOMATION_INTERVAL_MINUTES=15
# Si corre detrás de un proxy/balanceador (Render, Railway, Nginx…), pon "true".
TRUST_PROXY=false
# Primer administrador (solo se usa si la base de datos no tiene usuarios).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
